{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "features": ["webui"]
  },
  "bundle": {
    "targets": ["deb"],
    "linux": {
      "deb": {
        "depends": ["nftables", "iproute2", "pkexec", "adduser"],
        "conflicts": ["netagg-server"],
        "files": {
          "/usr/lib/systemd/system/netagg.service": "./linux/netagg.service",
          "/usr/lib/systemd/system/netagg-webui.service": "./linux/netagg-webui.service",
          "/usr/share/netagg/www": "../dist/",
          "/usr/share/polkit-1/actions/dev.netagg.policy": "./linux/dev.netagg.policy"
        },
        "postInstallScript": "./linux/postinst.sh",
        "preRemoveScript": "./linux/prerm.sh",
        "postRemoveScript": "./linux/postrm.sh"
      }
    }
  }
}
