{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetAgg",
  "version": "1.3.0",
  "identifier": "dev.netagg",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "NetAgg",
        "width": 360,
        "height": 533,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "publisher": "NetAgg",
    "category": "Utility",
    "shortDescription": "Spreads the PC's traffic across several networks at once",
    "longDescription": "NetAgg sends each new connection through the network where it can expect the most bandwidth: Wi-Fi, Ethernet or a USB-tethered phone. A single download gets faster only if it opens several connections.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RjgxNEIzMzA0RjU1MDEKUldRQlZVOHdzeFQ0TkJIbVk0aEhuUytYejNKWjlJSkE3cDVQUzRKQTYrbU9nKy9PUlk3dUVPbG0K",
      "endpoints": ["https://github.com/shogorik/NetAgg/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
